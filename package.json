{
  "name": "local-copilot-webui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private, authenticated browser workspace for the local GitHub Copilot CLI.",
  "scripts": {
    "start": "node server.mjs",
    "check": "node --check server.mjs && node --check public/app.js",
    "test": "node --test test/server.test.mjs",
    "test:browser": "node test/browser.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.23.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "playwright": "^1.58.0"
  }
}
